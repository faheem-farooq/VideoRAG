# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (answer synthesis only, not required for retrieval) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Transcription backend ---
# "faster_whisper" (local, default, no key needed) or "api" (stub for a future hosted backend)
TRANSCRIPTION_BACKEND=faster_whisper
FASTER_WHISPER_MODEL_SIZE=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- Embedding ---
EMBEDDING_MODEL=sentence-transformers/LaBSE

# --- Chroma ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=video_segments

# --- Storage ---
UPLOAD_DIR=./data/uploads
JOB_DB_PATH=./data/jobs.db

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_QUERY=30/minute
QUERY_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
